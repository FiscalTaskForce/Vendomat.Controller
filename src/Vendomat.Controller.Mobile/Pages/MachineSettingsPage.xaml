<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:domainModels="clr-namespace:Vendomat.Controller.Domain.Models;assembly=Vendomat.Controller.Domain"
             xmlns:localization="clr-namespace:Vendomat.Controller.Client.Localization"
             xmlns:viewModels="clr-namespace:Vendomat.Controller.Mobile.ViewModels"
             x:Class="Vendomat.Controller.Mobile.Pages.MachineSettingsPage"
             x:Name="SettingsPageRoot"
             Shell.NavBarIsVisible="False"
             x:DataType="viewModels:MachineSettingsViewModel">

    <ContentPage.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Stroke" Value="{StaticResource StrokeSoft}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="26" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCardTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource MidnightBlue}" />
        </Style>

        <Style x:Key="SettingsCardDescriptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>

        <Style x:Key="SettingsFieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>

        <Style x:Key="SettingsEntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{StaticResource InfoSurface}" />
            <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
        </Style>

        <Style x:Key="SettingsTabButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="CornerRadius" Value="25" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="{StaticResource PanelBackground}" />
            <Setter Property="TextColor" Value="{StaticResource MidnightBlue}" />
            <Setter Property="BorderColor" Value="{StaticResource StrokeSoft}" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>

        <Style x:Key="SettingsDrawerButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="{StaticResource PanelBackground}" />
            <Setter Property="TextColor" Value="{StaticResource MidnightBlue}" />
            <Setter Property="BorderColor" Value="{StaticResource StrokeSoft}" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>

        <Style x:Key="SettingsAdjustButtonStyle" TargetType="Button">
            <Setter Property="WidthRequest" Value="56" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="20,18,20,24"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="18">

        <Border Padding="20"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">
                <Button Text=""
                        Padding="14,10"
                        WidthRequest="50"
                        Command="{Binding ToggleSettingsMenuCommand}"
                        Style="{StaticResource GhostButtonStyle}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#x2630;"
                                         FontFamily="OpenSansSemibold"
                                         Size="18"
                                         Color="White" />
                    </Button.ImageSource>
                </Button>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="6"
                                     VerticalOptions="Center">
                    <Label Text="{localization:Translate MobileSettingsTitle}"
                           Style="{StaticResource PageTitleLabelStyle}"
                           TextColor="White"
                           FontSize="26" />
                    <Label Text="{Binding StatusMessage}"
                           Style="{StaticResource PageSubtitleLabelStyle}"
                           TextColor="#E1F3E9" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,0,0,12"
                                 Spacing="16">

                <VerticalStackLayout IsVisible="{Binding IsConnectionTabSelected}"
                                     Spacing="16">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate MobileConnectionSectionTitle}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate MobileConnectionSectionSubtitle}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Padding="14"
                                        BackgroundColor="#EEF6FB"
                                        StrokeThickness="0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{localization:Translate MobileConnectionActiveModeTitle}"
                                               Style="{StaticResource SettingsFieldLabelStyle}" />
                                        <Label Text="{Binding ActiveConnectionModeTitle}"
                                               FontSize="16"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1"
                                        Padding="14"
                                        BackgroundColor="#F2F8F5"
                                        StrokeThickness="0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{localization:Translate MobileConnectionFallbackTitle}"
                                               Style="{StaticResource SettingsFieldLabelStyle}" />
                                        <Label Text="{Binding ConnectionAvailabilityText}"
                                               FontSize="13"
                                               TextColor="#355468" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate MobileConnectionActiveEndpointTitle}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Label Text="{Binding ActiveConnectionEndpoint}"
                                       FontSize="13"
                                       LineBreakMode="CharacterWrap" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate MobileConnectionFallbackTitle}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Label Text="{Binding ConnectionFallbackText}"
                                       FontSize="13"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate MobileConnectionStrategyTitle}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ConnectionModeOptions}"
                                                 Spacing="12">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ConnectionModeOptionViewModel">
                                        <Border Padding="16"
                                                BackgroundColor="#F8FBFD"
                                                Stroke="#D8E3EC"
                                                StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border"
                                                             Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#E7F4EC" />
                                                    <Setter Property="Stroke" Value="#1C6B4A" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference SettingsPageRoot}, Path=BindingContext.SelectConnectionModeCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding Description}"
                                                       FontSize="13"
                                                       TextColor="#5A6B78" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate SettingsPairingSection}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate SettingsPairingCardDescription}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />
                            <Label Text="{localization:Translate SettingsPairingSecurityHint}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsMachineIdLabel}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Entry Text="{Binding MachineIdentifier}"
                                       IsReadOnly="True"
                                       Style="{StaticResource SettingsEntryStyle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsLocalApiBaseUrlLabel}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Entry Text="{Binding LocalApiBaseUrl}"
                                       Placeholder="{localization:Translate SettingsApiBaseUrlPlaceholder}"
                                       Style="{StaticResource SettingsEntryStyle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsPublicApiBaseUrlLabel}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Entry Text="{Binding PublicApiBaseUrl}"
                                       Placeholder="{localization:Translate SettingsPublicApiBaseUrlPlaceholder}"
                                       Style="{StaticResource SettingsEntryStyle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsCloudApiBaseUrlLabel}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Entry Text="{Binding CloudApiBaseUrl}"
                                       Placeholder="{localization:Translate SettingsCloudApiBaseUrlPlaceholder}"
                                       Style="{StaticResource SettingsEntryStyle}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsSalesTabSelected}"
                                     Spacing="16">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate SettingsSalesCardTitle}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate SettingsSalesCardDescription}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsMachineNamePlaceholder}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Entry Text="{Binding MachineName}"
                                       Placeholder="{localization:Translate SettingsMachineNamePlaceholder}"
                                       Style="{StaticResource SettingsEntryStyle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsPricePlaceholder}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10">
                                    <Button Text="-"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding DecrementNumericSettingCommand}"
                                            CommandParameter="PricePerLiter" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding PricePerLiter}"
                                           Keyboard="Numeric"
                                           HorizontalTextAlignment="Center"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                    <Button Grid.Column="2"
                                            Text="+"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding IncrementNumericSettingCommand}"
                                            CommandParameter="PricePerLiter" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsPulsesPlaceholder}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10">
                                    <Button Text="-"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding DecrementNumericSettingCommand}"
                                            CommandParameter="PulsesPerLiter" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding PulsesPerLiter}"
                                           Keyboard="Numeric"
                                           HorizontalTextAlignment="Center"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                    <Button Grid.Column="2"
                                            Text="+"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding IncrementNumericSettingCommand}"
                                            CommandParameter="PulsesPerLiter" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsCurrentStockPlaceholder}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10">
                                    <Button Text="-"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding DecrementNumericSettingCommand}"
                                            CommandParameter="CurrentStockLiters" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding CurrentStockLiters}"
                                           Keyboard="Numeric"
                                           HorizontalTextAlignment="Center"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                    <Button Grid.Column="2"
                                            Text="+"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding IncrementNumericSettingCommand}"
                                            CommandParameter="CurrentStockLiters" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsTankCapacityPlaceholder}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10">
                                    <Button Text="-"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding DecrementNumericSettingCommand}"
                                            CommandParameter="TankCapacityLiters" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding TankCapacityLiters}"
                                           Keyboard="Numeric"
                                           HorizontalTextAlignment="Center"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                    <Button Grid.Column="2"
                                            Text="+"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding IncrementNumericSettingCommand}"
                                            CommandParameter="TankCapacityLiters" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsLowStockPlaceholder}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10">
                                    <Button Text="-"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding DecrementNumericSettingCommand}"
                                            CommandParameter="LowStockThresholdLiters" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding LowStockThresholdLiters}"
                                           Keyboard="Numeric"
                                           HorizontalTextAlignment="Center"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                    <Button Grid.Column="2"
                                            Text="+"
                                            Style="{StaticResource SettingsAdjustButtonStyle}"
                                            Command="{Binding IncrementNumericSettingCommand}"
                                            CommandParameter="LowStockThresholdLiters" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsGeneralTabSelected}"
                                     Spacing="16">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate SettingsAdminSection}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate SettingsAdminCardDescription}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />
                            <Label Text="{localization:Translate SettingsAdminPasscodeHint}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{localization:Translate SettingsAdminPasscodePlaceholder}"
                                           Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <Entry Text="{Binding NewAdminPasscode}"
                                           Keyboard="Numeric"
                                           IsPassword="True"
                                           Placeholder="{localization:Translate SettingsAdminPasscodePlaceholder}"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="6">
                                    <Label Text="{localization:Translate SettingsAdminPasscodeConfirmPlaceholder}"
                                           Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <Entry Text="{Binding ConfirmAdminPasscode}"
                                           Keyboard="Numeric"
                                           IsPassword="True"
                                           Placeholder="{localization:Translate SettingsAdminPasscodeConfirmPlaceholder}"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsPaymentsTabSelected}"
                                     Spacing="16">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate SettingsPaymentCardTitle}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate SettingsPaymentCardDescription}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Padding="14"
                                        BackgroundColor="#EEF6FB"
                                        StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10">
                                        <Switch IsToggled="{Binding CashPaymentEnabled}" />
                                        <Label Text="{localization:Translate SettingsCashPayment}"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Grid.Column="1"
                                        Padding="14"
                                        BackgroundColor="#EEF6FB"
                                        StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10">
                                        <Switch IsToggled="{Binding CardPaymentEnabled}" />
                                        <Label Text="{localization:Translate SettingsCardPayment}"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate SettingsContactCardTitle}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate SettingsContactCardDescription}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsContactPhonePlaceholder}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Entry Text="{Binding ContactPhone}"
                                       Keyboard="Telephone"
                                       Placeholder="{localization:Translate SettingsContactPhonePlaceholder}"
                                       Style="{StaticResource SettingsEntryStyle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate SettingsContactEmailPlaceholder}"
                                       Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Entry Text="{Binding ContactEmail}"
                                       Keyboard="Email"
                                       Placeholder="{localization:Translate SettingsContactEmailPlaceholder}"
                                       Style="{StaticResource SettingsEntryStyle}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsValidatorTabSelected}"
                                     Spacing="16">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate SettingsValidatorSection}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate SettingsValidatorCardDescription}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Padding="14"
                                        BackgroundColor="#EEF6FB"
                                        StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10">
                                        <Switch IsToggled="{Binding BillValidatorEnabled}" />
                                        <Label Text="{localization:Translate SettingsValidatorEnabled}"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Grid.Column="1"
                                        Padding="14"
                                        BackgroundColor="#EEF6FB"
                                        StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10">
                                        <Switch IsToggled="{Binding BillValidatorEscrowMode}" />
                                        <Label Text="{localization:Translate SettingsValidatorEscrow}"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{localization:Translate SettingsBillPortLabel}"
                                           Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <Entry Text="{Binding BillValidatorPortName}"
                                           Placeholder="{localization:Translate SettingsBillPortPlaceholder}"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="6">
                                    <Label Text="{localization:Translate SettingsBillBaudLabel}"
                                           Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <Entry Text="{Binding BillValidatorBaudRate}"
                                           Keyboard="Numeric"
                                           Placeholder="{localization:Translate SettingsBillBaudPlaceholder}"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate SettingsValidatorChannelsTitle}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate SettingsValidatorChannelsDescription}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <VerticalStackLayout Spacing="10"
                                                 BindableLayout.ItemsSource="{Binding CashChannels}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="domainModels:CashChannelSetting">
                                        <Border Padding="14"
                                                BackgroundColor="#EEF6FB"
                                                StrokeThickness="0">
                                            <Grid ColumnDefinitions="*,Auto,Auto"
                                                  ColumnSpacing="12">
                                                <Label Text="{Binding Label}"
                                                       VerticalOptions="Center"
                                                       FontAttributes="Bold" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Amount, StringFormat='{}{0:0.##} RON'}"
                                                       VerticalOptions="Center"
                                                       TextColor="#6E6E6E" />
                                                <Switch Grid.Column="2"
                                                        IsToggled="{Binding IsEnabled}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsEsp32TabSelected}"
                                     Spacing="16">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate SettingsEsp32Section}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate SettingsEsp32CardDescription}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <Border Padding="14"
                                        BackgroundColor="#EEF6FB"
                                        StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10">
                                        <Switch IsToggled="{Binding Esp32Enabled}" />
                                        <Label Text="{localization:Translate SettingsEsp32Enabled}"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Grid.Column="1"
                                        Padding="14"
                                        BackgroundColor="#EEF6FB"
                                        StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10">
                                        <Switch IsToggled="{Binding Esp32AutoDiscover}" />
                                        <Label Text="{localization:Translate SettingsEsp32AutoDiscover}"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{localization:Translate SettingsEsp32PortLabel}"
                                           Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <Entry Text="{Binding Esp32PortName}"
                                           Placeholder="{localization:Translate SettingsEsp32PortPlaceholder}"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="6">
                                    <Label Text="{localization:Translate SettingsEsp32BaudLabel}"
                                           Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <Entry Text="{Binding Esp32BaudRate}"
                                           Keyboard="Numeric"
                                           Placeholder="{localization:Translate SettingsEsp32BaudPlaceholder}"
                                           Style="{StaticResource SettingsEntryStyle}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsCleaningTabSelected}"
                                     Spacing="16">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{localization:Translate SettingsCleaningSection}"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                            <Label Text="{localization:Translate SettingsCleaningCardDescription}"
                                   Style="{StaticResource SettingsCardDescriptionStyle}" />

                            <VerticalStackLayout Spacing="12">
                                <Border Padding="16"
                                        BackgroundColor="#EEF6FB"
                                        StrokeThickness="0">
                                    <VerticalStackLayout Spacing="12">
                                        <Label Text="{localization:Translate SettingsContinuousCleaning}"
                                               FontAttributes="Bold"
                                               FontSize="16" />
                                        <Label Text="{localization:Translate SettingsContinuousCleaningDescription}"
                                               Style="{StaticResource SettingsCardDescriptionStyle}" />
                                        <Button Text="{localization:Translate SettingsContinuousCleaning}"
                                                Command="{Binding RunContinuousCleaningCommand}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Padding="16"
                                        BackgroundColor="#FFF2DF"
                                        StrokeThickness="0">
                                    <VerticalStackLayout Spacing="12">
                                        <Label Text="{localization:Translate SettingsPulsedCleaning}"
                                               FontAttributes="Bold"
                                               FontSize="16" />
                                        <Label Text="{localization:Translate SettingsPulsedCleaningDescription}"
                                               Style="{StaticResource SettingsCardDescriptionStyle}" />
                                        <Button Text="{localization:Translate SettingsPulsedCleaning}"
                                                Command="{Binding RunPulsedCleaningCommand}"
                                                BackgroundColor="#F3B255" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <Border Padding="16"
                                    BackgroundColor="#EAF7EF"
                                    StrokeThickness="0">
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="{localization:Translate SettingsPrimingTitle}"
                                           FontAttributes="Bold"
                                           FontSize="16" />
                                    <Label Text="{localization:Translate SettingsPrimingDescription}"
                                           Style="{StaticResource SettingsCardDescriptionStyle}" />
                                    <Button Text="{localization:Translate SettingsPrime200Ml}"
                                            Command="{Binding RunPrimingCommand}"
                                            BackgroundColor="#2F8F5B" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                Style="{StaticResource SettingsCardStyle}"
                Padding="14"
                BackgroundColor="{StaticResource White}">
            <Button Text="{localization:Translate SettingsSaveButton}"
                    Command="{Binding SaveCommand}"
                    HeightRequest="58" />
        </Border>

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsSettingsMenuOpen}"
              BackgroundColor="#99000000">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseSettingsMenuCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border WidthRequest="312"
                    Padding="18"
                    BackgroundColor="{StaticResource White}"
                    StrokeThickness="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Fill">
                <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="18">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{localization:Translate MobileSettingsMenuTitle}"
                               Style="{StaticResource SettingsCardTitleStyle}" />
                        <Label Text="{Binding StatusMessage}"
                               Style="{StaticResource SettingsCardDescriptionStyle}" />
                    </VerticalStackLayout>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="10">
                            <Button Text="{localization:Translate MobileConnectionSectionTitle}"
                                    Command="{Binding ShowConnectionTabCommand}"
                                    Style="{StaticResource SettingsDrawerButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsConnectionTabSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderWidth" Value="0" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{localization:Translate SettingsSalesTab}"
                                    Command="{Binding ShowSalesTabCommand}"
                                    Style="{StaticResource SettingsDrawerButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsSalesTabSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderWidth" Value="0" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{localization:Translate SettingsGeneralSection}"
                                    Command="{Binding ShowGeneralTabCommand}"
                                    Style="{StaticResource SettingsDrawerButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsGeneralTabSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderWidth" Value="0" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{localization:Translate SettingsPaymentSection}"
                                    Command="{Binding ShowPaymentsTabCommand}"
                                    Style="{StaticResource SettingsDrawerButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsPaymentsTabSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderWidth" Value="0" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{localization:Translate SettingsValidatorSection}"
                                    Command="{Binding ShowValidatorTabCommand}"
                                    Style="{StaticResource SettingsDrawerButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsValidatorTabSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderWidth" Value="0" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{localization:Translate SettingsEsp32Section}"
                                    Command="{Binding ShowEsp32TabCommand}"
                                    Style="{StaticResource SettingsDrawerButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsEsp32TabSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderWidth" Value="0" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{localization:Translate SettingsCleaningSection}"
                                    Command="{Binding ShowCleaningTabCommand}"
                                    Style="{StaticResource SettingsDrawerButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsCleaningTabSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderWidth" Value="0" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Button Grid.Row="2"
                            Text="{localization:Translate MobileSettingsExitSettings}"
                            Clicked="OnBackClicked"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HeightRequest="52" />
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>

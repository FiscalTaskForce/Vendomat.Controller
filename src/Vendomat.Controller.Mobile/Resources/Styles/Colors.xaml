<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#1C6B4A</Color>
    <Color x:Key="PrimaryDark">#154E37</Color>
    <Color x:Key="PrimaryDarkText">#10261D</Color>
    <Color x:Key="Secondary">#E6F3EC</Color>
    <Color x:Key="SecondaryDarkText">#5B6F66</Color>
    <Color x:Key="Tertiary">#D8924A</Color>

    <Color x:Key="White">#FFFDF8</Color>
    <Color x:Key="Black">#17242E</Color>
    <Color x:Key="Magenta">#C96A4B</Color>
    <Color x:Key="MidnightBlue">#173042</Color>
    <Color x:Key="OffBlack">#12201A</Color>

    <Color x:Key="Gray100">#F4F1EA</Color>
    <Color x:Key="Gray200">#E4DCD0</Color>
    <Color x:Key="Gray300">#CEC4B6</Color>
    <Color x:Key="Gray400">#A79B89</Color>
    <Color x:Key="Gray500">#70675D</Color>
    <Color x:Key="Gray600">#4A4945</Color>
    <Color x:Key="Gray900">#26333C</Color>
    <Color x:Key="Gray950">#1A242B</Color>

    <Color x:Key="AppBackground">#F7F3EC</Color>
    <Color x:Key="CardBackground">#FFFDF8</Color>
    <Color x:Key="PanelBackground">#F9F5EE</Color>
    <Color x:Key="HeroStart">#1A6546</Color>
    <Color x:Key="HeroEnd">#2D8A61</Color>
    <Color x:Key="WarmSurface">#FFF1E2</Color>
    <Color x:Key="InfoSurface">#EAF4FB</Color>
    <Color x:Key="SuccessSurface">#E7F4EC</Color>
    <Color x:Key="DangerSurface">#FBE7E2</Color>
    <Color x:Key="DangerText">#A14334</Color>
    <Color x:Key="StrokeSoft">#E6DCCF</Color>
    <Color x:Key="ShadowColor">#14000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <LinearGradientBrush x:Key="HeroBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{StaticResource HeroStart}" Offset="0" />
        <GradientStop Color="{StaticResource HeroEnd}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PageBackgroundBrush"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#FBF8F2" Offset="0" />
        <GradientStop Color="{StaticResource AppBackground}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>

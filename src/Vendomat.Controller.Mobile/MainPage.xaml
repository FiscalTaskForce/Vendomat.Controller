<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:Vendomat.Controller.Client.Localization"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:viewModels="clr-namespace:Vendomat.Controller.Mobile.ViewModels"
             x:Class="Vendomat.Controller.Mobile.MainPage"
             x:Name="DevicesPage"
             x:DataType="viewModels:MainPageViewModel"
             Shell.NavBarIsVisible="False">

    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}">
        <Grid Padding="20,18,20,24"
              RowDefinitions="Auto,*"
              RowSpacing="18">
            <Border Grid.Row="0"
                    Padding="20"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,112"
                      RowSpacing="16"
                      ColumnSpacing="14">
                    <Border Grid.ColumnSpan="2"
                            Padding="10,0"
                            BackgroundColor="#22FFFFFF"
                            Stroke="#33FFFFFF"
                            StrokeThickness="1">
                        <syncfusion:SfComboBox x:Name="MobileLanguageComboBox"
                                               ItemsSource="{Binding AvailableLanguages}"
                                               SelectedItem="{Binding SelectedLanguageOption}"
                                               DisplayMemberPath="NativeName"
                                               TextMemberPath="NativeName"
                                               IsEditable="False"
                                               MaxDropDownHeight="180"
                                               DropDownItemHeight="56"
                                               Background="Transparent"
                                               Stroke="Transparent"
                                               DropDownIconColor="White"
                                               SelectedDropDownItemBackground="{StaticResource SuccessSurface}"
                                               HeightRequest="54">
                            <syncfusion:SfComboBox.CustomView>
                                <Grid InputTransparent="True"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10"
                                      Padding="8,0">
                                    <Image Source="{Binding SelectedLanguageOption.FlagImagePath, TargetNullValue=ro.svg}"
                                           WidthRequest="28"
                                           HeightRequest="20"
                                           Aspect="AspectFill"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding SelectedLanguageOption.NativeName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </syncfusion:SfComboBox.CustomView>
                            <syncfusion:SfComboBox.ItemTemplate>
                                <DataTemplate x:DataType="localization:LanguageOption">
                                    <Grid Padding="10,8"
                                          ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12">
                                        <Image Source="{Binding FlagImagePath}"
                                               WidthRequest="30"
                                               HeightRequest="22"
                                               Aspect="AspectFill"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="1"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding NativeName}"
                                                   FontSize="14"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding CountryCode}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray500}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </syncfusion:SfComboBox.ItemTemplate>
                        </syncfusion:SfComboBox>
                    </Border>

                    <Button Grid.Row="1"
                            Text="{localization:Translate MobileAddDevice}"
                            Command="{Binding OpenScannerCommand}"
                            FontSize="14"
                            Padding="10,12"
                            LineBreakMode="NoWrap" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Text="{localization:Translate CommonRefresh}"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButtonStyle}" />
                </Grid>
            </Border>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Devices}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="24"
                            Margin="0,6,0,0">
                        <VerticalStackLayout Spacing="12"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Label Text="{localization:Translate MobileDevicesEmptyTitle}"
                                   Style="{StaticResource PageTitleLabelStyle}"
                                   FontSize="24"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{localization:Translate MobileDevicesEmptySubtitle}"
                                   Style="{StaticResource PageSubtitleLabelStyle}"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="{localization:Translate MobileAddDevice}"
                                    Command="{Binding OpenScannerCommand}"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DeviceCardViewModel">
                        <Border Margin="0,0,0,14"
                                Style="{StaticResource CardBorderStyle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference DevicesPage}, Path=BindingContext.OpenDetailsCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="14"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding MachineName}"
                                           Style="{StaticResource SectionTitleLabelStyle}"
                                           FontSize="20" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        Padding="12,7"
                                        StrokeThickness="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsOnline}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessSurface}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsOnline}"
                                                     Value="False">
                                            <Setter Property="BackgroundColor" Value="{StaticResource WarmSurface}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding AvailabilityText}"
                                           Style="{StaticResource BadgeLabelStyle}" />
                                </Border>

                                <VerticalStackLayout Grid.Row="1"
                                                     Grid.ColumnSpan="2"
                                                     Spacing="10">
                                    <Border Style="{StaticResource MetricCardBorderStyle}"
                                            BackgroundColor="{StaticResource InfoSurface}">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="12">
                                            <Label Text="{Binding StockLabel}"
                                                   Style="{StaticResource MetricCaptionLabelStyle}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding StockText}"
                                                   Style="{StaticResource MetricValueLabelStyle}"
                                                   FontSize="17"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource MetricCardBorderStyle}">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="12">
                                            <Label Text="{Binding TemperatureLabel}"
                                                   Style="{StaticResource MetricCaptionLabelStyle}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding TemperatureText}"
                                                   Style="{StaticResource MetricValueLabelStyle}"
                                                   FontSize="17"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource MetricCardBorderStyle}"
                                            BackgroundColor="{StaticResource WarmSurface}">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="12">
                                            <Label Text="{Binding PriceLabel}"
                                                   Style="{StaticResource MetricCaptionLabelStyle}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding PriceText}"
                                                   Style="{StaticResource MetricValueLabelStyle}"
                                                   FontSize="17"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <Grid Grid.Row="2"
                                      Grid.ColumnSpan="2">
                                    <Border Padding="14"
                                            BackgroundColor="{StaticResource Secondary}"
                                            StrokeThickness="0">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding ConnectionModeText}"
                                                   Style="{StaticResource BadgeLabelStyle}"
                                                   HorizontalTextAlignment="Start" />
                                            <Label Text="{Binding LastSeenText}"
                                                   Style="{StaticResource SectionCaptionLabelStyle}" />
                                            <Label Text="{Binding ApiBaseUrl}"
                                                   Style="{StaticResource SectionCaptionLabelStyle}"
                                                   LineBreakMode="CharacterWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Grid.Row="3"
                                                     Grid.ColumnSpan="2"
                                                     Spacing="10">
                                    <Button Text="{localization:Translate MobileDevicesOpenDashboard}"
                                            Command="{Binding Source={x:Reference DevicesPage}, Path=BindingContext.OpenDetailsCommand}"
                                            CommandParameter="{Binding .}"
                                            HorizontalOptions="Fill"
                                            Padding="12,14" />
                                    <Button Text="{localization:Translate MobileDevicesOpenSettings}"
                                            Command="{Binding Source={x:Reference DevicesPage}, Path=BindingContext.OpenSettingsCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalOptions="Fill"
                                            Padding="12,14" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentPage>
